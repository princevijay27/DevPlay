# Database
# Local Postgres URL used by apps/api and packages/db
DATABASE_URL=postgres://postgres:postgres@localhost:5432/devflow

# Redis
# Local Redis URL used for queues, caching, and background jobs
REDIS_URL=redis://localhost:6379

# Clerk
# Clerk publishable key from Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Clerk secret key from Clerk Dashboard -> API Keys
CLERK_SECRET_KEY=sk_test_replace_me
# Clerk webhook signing secret from Clerk Dashboard -> Webhooks
CLERK_WEBHOOK_SECRET=whsec_replace_me

# API
# Public API base URL consumed by the Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
# Fastify port for local development
PORT=4000

# AI
# Anthropic API key for Claude Sonnet voice/task workflows
ANTHROPIC_API_KEY=anthropic_replace_me
# Optional OpenAI API key for transcription or future fallback flows
OPENAI_API_KEY=openai_replace_me

# Email / notifications
# Resend API key used for digest emails
RESEND_API_KEY=re_replace_me

# Observability
# Optional Sentry DSN for frontend error reporting
NEXT_PUBLIC_SENTRY_DSN=
